<section class="program-page">

  <!-- ── Hero: large image on top, text below ── -->
  <header class="program-hero">

    <!-- Image (full width) -->
    <div class="program-hero-media">
      <div class="program-img-frame">
        <img class="program-image" src="/assets/images/programs/<%= program.slug %>.jpg" alt="<%= program.name %>"
          onerror="this.parentElement.innerHTML='<div class=\'img-placeholder\'><span>📚</span><p>No image available yet</p></div>'" />
        <div class="program-img-overlay">
          <div class="program-img-title">
            <span class="program-eyebrow">Library Program</span>
            <h1>
              <%= program.name %>
            </h1>
          </div>
        </div>
      </div>
    </div>

    <!-- Text below the image -->
    <div class="program-hero-text">
      <p class="program-summary">
        <%= program.summary || "Details coming soon." %>
      </p>
      <div class="program-cta-row">
        <a class="btn btn-primary" href="/contact">Inquire Now</a>
        <a class="btn" href="/programs">← Back to Programs</a>
      </div>
    </div>

  </header>

  <!-- ── About section ── -->
  <section class="program-section">
    <div class="program-section-header">
      <h2>About this Program</h2>
      <div class="section-divider"></div>
    </div>
    <div class="program-description">
      <% if (Array.isArray(program.description)) { %>
        <% program.description.forEach(p=> { %>
          <p>
            <%= p %>
          </p>
          <% }) %>
            <% } else { %>
              <p>
                <%= program.description || "Full description coming soon." %>
              </p>
              <% } %>
    </div>
  </section>

  <!-- ── Program Images Gallery ── -->
  <section class="program-section">
    <div class="program-section-header">
      <h2>Program Images</h2>
      <div class="section-divider"></div>
    </div>

    <% if (programImages && programImages.length> 0) { %>
      <div
        style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; margin-top: 20px;">
        <% programImages.forEach(img=> { %>
          <div style="position: relative; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <img src="<%= img.url %>" alt="<%= img.caption || program.name %>"
              style="width: 100%; height: 200px; object-fit: cover;"
              onerror="this.parentElement.innerHTML='<div class=\'img-placeholder\'><span>📷</span><p>Image failed to load</p></div>'">
            <% if (img.caption) { %>
              <div style="padding: 10px; background: var(--bg-secondary); font-size: 0.9rem;">
                <%= img.caption %>
              </div>
              <% } %>
          </div>
          <% }) %>
      </div>
      <% } else { %>
        <div class="img-placeholder" style="margin: 40px auto; max-width: 400px; text-align: center;">
          <span style="font-size: 3rem; display: block; margin-bottom: 10px;">📷</span>
          <p style="color: var(--text-muted);">No images available for this program yet.</p>
        </div>
        <% } %>
  </section>

</section>