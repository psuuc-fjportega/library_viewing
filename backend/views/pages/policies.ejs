<section class="page-header">
  <h1>Library Policies & Services</h1>
  <p class="muted">A guide to our membership, borrowing procedures, and code of conduct.</p>
</section>

<div class="policies-wrapper reveal-stagger">

  <!-- Section 1 -->
  <div class="policy-group">
    <div class="group-title">
      <span class="emoji">🪪</span>
      <h2>Membership & Access</h2>
    </div>
    <div class="policy-card">
      <ul class="refined-list">
        <li><strong>Open for All:</strong> Library use is open to everyone in the community.</li>
        <li><strong>Main Library Membership:</strong> Residents with a library card may loan materials.</li>
        <li><strong>Lending Restriction:</strong> Library cards are personal and non-transferable.</li>
        <li><strong>Membership Duration:</strong> Cards are valid for one year and renewable upon confirmation.</li>
        <li><strong>Child Safety:</strong> Children under 6 must be accompanied by a parent or guardian.</li>
        <li><strong>Accounts:</strong> All accounts must be settled before borrowing new resources.</li>
      </ul>
    </div>
  </div>

  <!-- Section 2 -->
  <div class="policy-group">
    <div class="group-title">
      <span class="emoji">📚</span>
      <h2>Borrowing & Schedules</h2>
    </div>
    <div class="policy-card">
      <div class="policy-intro">
        <p>Main Library members may loan up to <strong>3 books</strong> (other users limited to 2). Only donated
          materials are available for loan.</p>
        <p class="schedule"><strong>Schedule:</strong> Monday to Wednesday only.</p>
      </div>

      <div class="loan-grid">
        <div class="loan-item">
          <strong>Fiction</strong>
          <span>7 Days</span>
          <small>Renewable once</small>
        </div>
        <div class="loan-item">
          <strong>General Collection</strong>
          <span>3 Days</span>
          <small>Fine: ₱2.00/day</small>
        </div>
        <div class="loan-item">
          <strong>Filipiniana & Reserved</strong>
          <span>Overnight</span>
          <small>Fine: ₱2.00/day</small>
        </div>
        <div class="loan-item">
          <strong>Easy Books</strong>
          <span>Overnight</span>
          <small>Designated for kids</small>
        </div>
      </div>
    </div>
  </div>

  <!-- Section 3 -->
  <div class="policy-group">
    <div class="group-title">
      <span class="emoji">🏛️</span>
      <h2>In-Library Resources</h2>
    </div>
    <div class="policy-card accent-blue">
      <div class="resource-row">
        <div class="resource-block">
          <h3>Room-Use Only</h3>
          <p>General References (Dictionaries, Encyclopedias, Atlases), Periodicals (Magazines, Journals), and Vertical
            Files.</p>
        </div>
        <div class="resource-block">
          <h3>Photocopying</h3>
          <p>Materials must be officially issued out and properly received before photocopying.</p>
        </div>
      </div>
      <p class="staff-text">*City Hall employees may borrow these for overnight use only.</p>
    </div>
  </div>

  <!-- Section 4 -->
  <div class="policy-group">
    <div class="group-title">
      <span class="emoji">🛡️</span>
      <h2>Care & Responsibilities</h2>
    </div>
    <div class="policy-card accent-red">
      <div class="responsibility-grid">
        <div class="resp-item">
          <h4>Reporting Loss</h4>
          <p>Lost books must be reported immediately. Replacement requires the same title/author or payment of current
            price plus <strong>₱12.00</strong> fee.</p>
        </div>
        <div class="resp-item">
          <h4>Material Care</h4>
          <p>Handle all items with care. Damage or vandalism will result in disciplinary action. Please report any
            issues to the Librarian.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Section 5 -->
  <div class="policy-group">
    <div class="group-title">
      <span class="emoji">🔇</span>
      <h2>Code of Conduct</h2>
    </div>
    <div class="policy-card conduct-card">
      <div class="conduct-flex">
        <span>🤫 Maintain silence. Cellphones on silent mode.</span>
        <span>🚫 No smoking, eating, littering, or loitering.</span>
        <span>🙏 Observe courtesy at all times toward staff and users.</span>
      </div>
      <div class="important-notice">
        <p><strong>Note:</strong> Unauthorized removal of books will result in a one-month suspension.</p>
      </div>
    </div>
  </div>

</div>

