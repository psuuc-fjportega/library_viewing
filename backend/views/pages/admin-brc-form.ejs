<section class="page-header">
  <h1><%= brc ? 'Edit BRC' : 'Add New BRC' %></h1>
  <p class="muted"><%= brc ? 'Update reading center details' : 'Fill in the details for the new center' %></p>
</section>

<div style="display:flex; gap:10px; margin-bottom:16px;">
  <a href="/admin/brc" class="btn btn-outline btn-small">← Back to BRCs</a>
</div>

<section class="card">
  <form
    action="<%= brc ? '/admin/brc/' + brc._id + '/edit' : '/admin/brc' %>"
    method="POST"
    enctype="multipart/form-data"
    class="form"
  >
    <div class="form-group">
      <label for="name">Center Name (Barangay)</label>
      <input
        type="text"
        id="name"
        name="name"
        value="<%= brc ? brc.name : '' %>"
        required
        class="form-control"
        placeholder="e.g. Brgy. Poblacion Reading Center"
      >
    </div>

    <div class="form-group">
      <label for="statement">Statement / Description</label>
      <textarea
        id="statement"
        name="statement"
        required
        rows="6"
        class="form-control"
        placeholder="Brief description of the center..."
      ><%= brc ? brc.statement : '' %></textarea>
    </div>

    <div class="form-group">
      <label for="facebookLink">Facebook Link (Optional)</label>
      <input
        type="url"
        id="facebookLink"
        name="facebookLink"
        value="<%= brc ? (brc.facebookLink || '') : '' %>"
        class="form-control"
        placeholder="https://www.facebook.com/..."
      >
      <p class="muted" style="margin-top: 5px; font-size: 0.85rem;">Link to the BRC's Facebook page (will appear as a button in the modal)</p>
    </div>

    <%
      // Resolve cover image: Cloudinary first, then local fallback
      const coverResolved =
        (brc && brc.coverUrl) ? brc.coverUrl :
        (brc && brc.coverImage) ? ('/assets/brc/uploads/' + brc.coverImage) :
        '';

      // Resolve gallery images list:
      // - Prefer Cloudinary arrays if present
      // - Otherwise fall back to local filenames
      const cloudUrls = (brc && Array.isArray(brc.imageUrls)) ? brc.imageUrls : [];
      const cloudPublicIds = (brc && Array.isArray(brc.imagePublicIds)) ? brc.imagePublicIds : [];
      const localFiles = (brc && Array.isArray(brc.images)) ? brc.images : [];

      const hasCloudGallery = cloudUrls.length > 0;
      const hasLocalGallery = localFiles.length > 0;
    %>

    <div class="form-group" style="margin-top:20px; border-top: 1px solid var(--border-color); padding-top: 20px;">
      <label for="coverImage">Cover Image</label>

      <% if (brc && coverResolved) { %>
        <div style="margin-bottom: 10px;">
          <p class="muted" style="margin-bottom: 5px;">Current Cover:</p>
          <img
            src="<%= coverResolved %>"
            alt="Cover"
            style="max-width: 200px; border-radius: 8px;"
            onerror="this.outerHTML='<span class=&quot;muted&quot;>Cover preview failed to load</span>'"
          >
        </div>
        <p class="muted"><small>Upload a new image to replace the current cover, or leave blank to keep it.</small></p>
      <% } else { %>
        <p class="muted"><small>Required. Used on the main BRC directory page.</small></p>
      <% } %>

      <input
        type="file"
        id="coverImage"
        name="coverImage"
        accept="image/*"
        <%= !brc ? 'required' : '' %>
        class="form-control"
      >
    </div>

    <div class="form-group" style="margin-top:20px; border-top: 1px solid var(--border-color); padding-top: 20px;">
      <label for="images">Gallery Images</label>
      <p class="muted"><small>Select multiple images to add to the gallery.</small></p>
      <input type="file" id="images" name="images" accept="image/*" multiple class="form-control">
    </div>

    <% if (brc && (hasCloudGallery || hasLocalGallery)) { %>
      <div class="form-group" style="margin-top: 20px;">
        <label>Current Gallery Images</label>
        <p class="muted">
          <small>
            Check the box below an image to <strong>remove</strong> it when you save.
            <br>
            (Cloudinary images remove by public id; local images remove by filename.)
          </small>
        </p>

        <div style="display:flex; gap:15px; flex-wrap:wrap; margin-top:10px;">
          <% if (hasCloudGallery) { %>
            <% cloudUrls.forEach((url, idx) => { 
              const pid = cloudPublicIds[idx] || '';
            %>
              <div style="border:1px solid var(--border-color); padding:5px; border-radius:8px; text-align:center;">
                <img
                  src="<%= url %>"
                  style="width:100px; height:100px; object-fit:cover; border-radius:4px; display:block; margin-bottom:5px;"
                  onerror="this.outerHTML='<div class=&quot;program-logo-fallback&quot; style=&quot;width:100px;height:100px;display:flex;align-items:center;justify-content:center;border-radius:4px;&quot;>🖼️</div>'"
                >
                <label style="font-size:0.8rem; display:flex; align-items:center; justify-content:center; gap:4px; margin:0; cursor:pointer;">
                  <input type="checkbox" name="removeImagePublicIds" value="<%= pid %>" <%= !pid ? 'disabled' : '' %>>
                  Remove
                </label>
                <% if (!pid) { %>
                  <div class="muted" style="font-size:0.75rem; margin-top:4px;">(missing public id)</div>
                <% } %>
              </div>
            <% }) %>
          <% } %>

          <% if (hasLocalGallery) { %>
            <% localFiles.forEach(fn => { %>
              <div style="border:1px solid var(--border-color); padding:5px; border-radius:8px; text-align:center;">
                <img
                  src="/assets/brc/uploads/<%= fn %>"
                  style="width:100px; height:100px; object-fit:cover; border-radius:4px; display:block; margin-bottom:5px;"
                  onerror="this.outerHTML='<div class=&quot;program-logo-fallback&quot; style=&quot;width:100px;height:100px;display:flex;align-items:center;justify-content:center;border-radius:4px;&quot;>🖼️</div>'"
                >
                <label style="font-size:0.8rem; display:flex; align-items:center; justify-content:center; gap:4px; margin:0; cursor:pointer;">
                  <input type="checkbox" name="removeImages" value="<%= fn %>"> Remove
                </label>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>
    <% } %>

    <div style="margin-top:30px;">
      <button type="submit" class="btn btn-primary">
        <%= brc ? 'Save Changes' : 'Create BRC' %>
      </button>
    </div>
  </form>
</section>