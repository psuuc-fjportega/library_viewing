      </div>
      <div class="award-content">
        <div class="award-title"><%= award.title %></div>
        <% if (award.org) { %>
          <div class="award-org"><%= award.org %></div>
        <% } %>
        <div class="award-date"><%= award.date %></div>
      </div>
    </div>
  <% }) %>
</section>