<section class="page-header">
  <h1>Gallery</h1>
  <p class="muted">Highlights from library activities and community programs.</p>
</section>

<section class="gallery-grid">
  <% if (!images || images.length===0) { %>
    <div class="alert alert-info" style="margin:20px 0;">
      <span class="alert-icon">📷</span> No gallery images have been added yet.
    </div>
    <% } else { %>
      <% images.forEach((img, idx)=> { %>
        <div class="gallery-item reveal">
          <img src="<%= img._thumbUrl %>" data-full="<%= img._fullUrl %>" data-caption="<%= img.caption %>"
            alt="<%= img.caption %>" loading="lazy" decoding="async" width="480" height="320" class="js-gallery-img" />

          <div class="gallery-caption">
            <%= img.caption %>
          </div>
        </div>
        <% }) %>
          <% } %>
</section>

<!-- Pagination -->
<% if (totalPages> 1) { %>
  <nav class="pagination" aria-label="Gallery pages">
    <% if (currentPage> 1) { %>
      <a class="page-btn" href="/gallery?page=<%= currentPage - 1 %>" aria-label="Previous page">&#8592; Prev</a>
      <% } else { %>
        <span class="page-btn page-btn--disabled">&#8592; Prev</span>
        <% } %>

          <div class="page-numbers">
            <% for (let p=1; p <=totalPages; p++) { %>
              <% if (p===currentPage) { %>
                <span class="page-num page-num--active">
                  <%= p %>
                </span>
                <% } else if (p===1 || p===totalPages || (p>= currentPage - 2 && p <= currentPage + 2)) { %>
                    <a class="page-num" href="/gallery?page=<%= p %>">
                      <%= p %>
                    </a>
                    <% } else if (p===currentPage - 3 || p===currentPage + 3) { %>
                      <span class="page-ellipsis">…</span>
                      <% } %>
                        <% } %>
          </div>

          <% if (currentPage < totalPages) { %>
            <a class="page-btn" href="/gallery?page=<%= currentPage + 1 %>" aria-label="Next page">Next &#8594;</a>
            <% } else { %>
              <span class="page-btn page-btn--disabled">Next &#8594;</span>
              <% } %>
  </nav>
  <% } %>

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox" aria-hidden="true" style="display:none;"
      data-count="<%= images ? images.length : 0 %>">
      <button class="lightbox-close" type="button" aria-label="Close">×</button>
      <button class="lightbox-prev" type="button" aria-label="Previous image">&#10094;</button>
      <button class="lightbox-next" type="button" aria-label="Next image">&#10095;</button>

      <div class="lightbox-inner">
        <img class="lightbox-img" src="" alt="">
        <div class="lightbox-caption"></div>
      </div>

      <div class="lightbox-counter"></div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        // Prevent double-init
        if (window.__UCPL_GALLERY_LIGHTBOX_INIT__) return;
        window.__UCPL_GALLERY_LIGHTBOX_INIT__ = true;

        const lightbox = document.getElementById("lightbox");
        if (!lightbox) return;

        const imgEl = lightbox.querySelector(".lightbox-img");
        const captionEl = lightbox.querySelector(".lightbox-caption");
        const closeBtn = lightbox.querySelector(".lightbox-close");
        const prevBtn = lightbox.querySelector(".lightbox-prev");
        const nextBtn = lightbox.querySelector(".lightbox-next");
        const counterEl = lightbox.querySelector(".lightbox-counter");

        const thumbs = Array.from(document.querySelectorAll(".js-gallery-img"));
        if (!thumbs.length) return;

        let currentIndex = -1;

        // Make thumbnails clickable + keyboard accessible
        thumbs.forEach((t) => {
          // tabindex already set or we can set it here if missing
          if (!t.hasAttribute("tabindex")) {
            t.setAttribute("tabindex", "0");
          }
        });

        function getFullUrl(i) {
          const t = thumbs[i];
          return (t && (t.getAttribute("data-full") || t.src)) || "";
        }

        function getCaption(i) {
          const t = thumbs[i];
          return (t && (t.getAttribute("data-caption") || t.alt || "")) || "";
        }

        function preload(i) {
          const url = getFullUrl(i);
          if (!url) return;
          const im = new Image();
          im.src = url;
        }

        function updateCounter(i) {
          if (counterEl) {
            counterEl.textContent = `${i + 1} / ${thumbs.length}`;
          }
        }

        function openAt(i) {
          if (!thumbs.length) return;

          currentIndex = i;
          if (currentIndex < 0) currentIndex = thumbs.length - 1;
          if (currentIndex >= thumbs.length) currentIndex = 0;

          const full = getFullUrl(currentIndex);
          const caption = getCaption(currentIndex);

          // Set Loading State
          lightbox.classList.add("is-loading");

          // To trigger CSS animation on image change, we can force a reflow
          imgEl.style.animation = 'none';
          imgEl.offsetWidth; // trigger reflow (using offsetWidth is fine)
          imgEl.style.animation = null;

          // Load image fully before showing
          const tempImg = new Image();
          tempImg.onload = () => {
            imgEl.src = full;
            imgEl.alt = caption;
            captionEl.textContent = caption;
            lightbox.classList.remove("is-loading");
          };
          tempImg.src = full;

          updateCounter(currentIndex);

          if (lightbox.style.display === "none" || lightbox.style.display === "") {
            lightbox.style.display = "flex";
            lightbox.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
          }

          // Preload neighbors
          preload((currentIndex + 1) % thumbs.length);
          preload((currentIndex - 1 + thumbs.length) % thumbs.length);
        }

        function close() {
          lightbox.style.display = "none";
          lightbox.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
          imgEl.src = ""; // Clear so it doesn't flash old image next time
        }

        function nextImg(e) { e && e.stopPropagation(); openAt(currentIndex + 1); }
        function prevImg(e) { e && e.stopPropagation(); openAt(currentIndex - 1); }

        // Click thumb to open
        thumbs.forEach((t, idx) => {
          // Find the parent .gallery-item if thumb doesn't fill the click area perfectly,
          // but clicking the img works fine here.
          t.closest('.gallery-item')?.addEventListener("click", () => openAt(idx));
          t.addEventListener("keydown", (e) => {
            if (e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              openAt(idx);
            }
          });
        });

        // Click actions
        if (closeBtn) closeBtn.addEventListener("click", close);
        if (nextBtn) nextBtn.addEventListener("click", nextImg);
        if (prevBtn) prevBtn.addEventListener("click", prevImg);

        // Click outside image closes (clicking the overlay)
        lightbox.addEventListener("click", (e) => {
          if (e.target === lightbox || e.target.classList.contains("lightbox-inner")) {
            close();
          }
        });

        // Keyboard controls
        document.addEventListener("keydown", (e) => {
          const open = lightbox.getAttribute("aria-hidden") === "false";
          if (!open) return;

          if (e.key === "Escape") close();
          if (e.key === "ArrowRight") nextImg();
          if (e.key === "ArrowLeft") prevImg();
        });
      });
    </script>