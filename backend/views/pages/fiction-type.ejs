<section class="page-header">
  <h1><%= typeTitle %></h1>
  <p><%= typeDescription %></p>
</section>

<section class="fiction-detail-section">
  <div class="fiction-detail-card">
    <div class="fiction-detail-header">
      <span class="fiction-detail-icon">📖</span>
      <h2>Overview</h2>
    </div>
    <p class="fiction-detail-body"><%= typeBody %></p>

    <div class="fiction-detail-actions">
      <a class="btn btn-outline" href="/collections/fiction">&larr; Back to Fiction</a>
      <a class="btn btn-ghost" href="/collections">All Collections</a>
    </div>
  </div>
</section>

<style>
  .fiction-detail-section {
    max-width: 820px;
    margin: 0 auto;
    opacity: 0;
    transform: translateY(16px);
    animation: detailIn 600ms ease forwards;
  }

  @keyframes detailIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fiction-detail-card {
    background: #fff;
    border: 1px solid rgba(184, 145, 72, 0.15);
    border-radius: 20px;
    padding: 36px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    position: relative;
    overflow: hidden;
  }

  .fiction-detail-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--gold, #b89148), var(--wine, #732a33));
  }

  .fiction-detail-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 2px solid rgba(184, 145, 72, 0.1);
  }

  .fiction-detail-icon {
    font-size: 1.5rem;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(184, 145, 72, 0.1);
    border-radius: 12px;
    flex-shrink: 0;
  }

  .fiction-detail-header h2 {
    margin: 0;
    font-family: "Playfair Display", serif;
    font-size: 1.35rem;
    color: var(--royal, #1e3a5f);
    font-weight: 700;
  }

  .fiction-detail-body {
    font-size: 1.05rem;
    color: var(--text, #333);
    line-height: 1.8;
    margin: 0;
  }

  .fiction-detail-actions {
    display: flex;
    gap: 12px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid rgba(184, 145, 72, 0.12);
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .fiction-detail-card {
      padding: 24px 18px;
    }

    .fiction-detail-actions {
      flex-direction: column;
    }

    .fiction-detail-actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
