<section class="page-header fade-in">
  <h1>Barangay Reading Centers</h1>
  <p class="muted">
    The Library Fun Day is a community-based literacy and early learning initiative of the Urdaneta
    City Library and Tech4ED Center, implemented through the network of Barangay Reading Centers (BRCs) in close
    coordination with partner agencies, particularly the City Social Welfare and Development Office (CSWDO) and
    other concerned local stakeholders. The program is designed to promote a sustained culture of reading, learning,
    and positive developmental engagement among children, with primary focus on those enrolled in Child Development
    Centers (CDCs) across Urdaneta City.
    Anchored in the principles of accessibility, inclusivity, and child-centered learning, the Library Fun Day
    extends library services beyond the City Library's physical premises into barangay communities, ensuring that
    young learners, especially those in underserved areas, are provided equitable access to quality literacy
    experiences.
  </p>
</section>

<section class="container fade-in" style="animation-delay: 0.1s;">
  <% if (!brcs || brcs.length === 0) { %>
    <p class="muted" style="text-align: center; margin: 40px 0;">No reading centers available at the moment.</p>
  <% } else { %>

    <div class="search-container" style="max-width: 600px; margin: 0 auto 40px; position: relative; z-index: 10;">
      <input
        type="text"
        class="live-search"
        style="width: 100%; padding: 10px 0; border: none; border-bottom: 2px solid #ddd; background: transparent; font-size: 1.1rem; box-shadow: none; outline: none; transition: border-color 0.3s ease;"
        placeholder="Search reading centers..."
        data-target=".program-grid .program-tile"
        data-no-results="#no-brc-results"
        onfocus="this.style.borderBottomColor='#333';"
        onblur="this.style.borderBottomColor='#ddd';"
      >
    </div>

    <div id="no-brc-results" class="muted" style="text-align: center; margin: 40px 0; display: none; font-size: 1.1rem;">
      No reading centers match your search.
    </div>

    <div class="program-grid">
      <% brcs.forEach(b => { %>
        <%
          const resolvedCover =
            b.coverUrl ||
            (b.coverImage ? ("/assets/brc/uploads/" + b.coverImage) : "");

          const summary =
            b.statement && b.statement.length > 100
              ? b.statement.substring(0, 100) + "..."
              : (b.statement || "");
        %>

        <button
          type="button"
          class="program-tile"
          data-program="<%= JSON.stringify({
            slug: b.slug,
            name: b.name,
            summary: summary,
            description: b.statement,
            logo: resolvedCover
          }) %>"
          aria-label="View details for <%= b.name %>"
        >
          <div class="program-tile-media">
            <% if (resolvedCover) { %>
              <img
                src="<%= resolvedCover %>"
                alt="<%= b.name %> Cover"
                onerror="this.outerHTML='<div class=&quot;program-logo-fallback&quot;>🏘️</div>'"
              >
            <% } else { %>
              <div class="program-logo-fallback">🏘️</div>
            <% } %>
          </div>

          <div class="program-tile-body">
            <div class="program-tile-title"><%= b.name %></div>
            <div class="program-tile-desc"><%= summary %></div>
          </div>
        </button>
      <% }) %>
    </div>
  <% } %>
</section>

<!-- MODAL (no navigation) -->
<div class="program-modal" id="programModal" aria-hidden="true">
  <div class="program-modal-backdrop" data-close="1"></div>

  <div class="program-modal-card" role="dialog" aria-modal="true" aria-labelledby="programModalTitle">
    <div class="program-modal-head">
      <div class="program-modal-head-left">
        <div class="program-modal-logo" id="programModalLogo">🏘️</div>
        <div>
          <div class="program-modal-eyebrow">Reading Center</div>
          <h2 id="programModalTitle" class="program-modal-title"></h2>
        </div>
      </div>

      <button class="program-modal-close" type="button" data-close="1" aria-label="Close">✕</button>
    </div>

    <p class="program-modal-summary" id="programModalSummary"></p>

    <div class="program-modal-section">
      <h3>About this Center</h3>
      <p id="programModalDescription"></p>
    </div>

    <div class="program-modal-actions">
      <a class="btn btn-primary" id="programModalLink" href="#">View Full Details</a>
      <button class="btn" type="button" data-close="1">Close</button>
    </div>
  </div>
</div>

<script>
  (function () {
    const modal = document.getElementById("programModal");
    const titleEl = document.getElementById("programModalTitle");
    const summaryEl = document.getElementById("programModalSummary");
    const descEl = document.getElementById("programModalDescription");
    const logoEl = document.getElementById("programModalLogo");
    const linkEl = document.getElementById("programModalLink");

    function openModal(program) {
      titleEl.textContent = program.name || "";
      summaryEl.textContent = program.summary || "Details coming soon.";
      descEl.textContent = program.description || "Full description coming soon.";
      linkEl.href = "/brc/" + program.slug;

      const logoUrl = program.logo;
      if (logoUrl) {
        logoEl.innerHTML =
          '<img src="' + logoUrl + '" alt="' + (program.name || "Center") + ' logo" onerror="this.parentElement.textContent=\'🏘️\'"/>';
      } else {
        logoEl.textContent = "🏘️";
      }

      modal.classList.add("is-open");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      modal.classList.remove("is-open");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    document.querySelectorAll(".program-tile").forEach((btn) => {
      btn.addEventListener("click", () => {
        try {
          const program = JSON.parse(btn.getAttribute("data-program"));
          openModal(program);
        } catch (e) {
          console.error("Failed to parse reading center data", e);
        }
      });
    });

    modal.addEventListener("click", (e) => {
      if (e.target && e.target.dataset && e.target.dataset.close) closeModal();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.classList.contains("is-open")) closeModal();
    });
  })();
</script>