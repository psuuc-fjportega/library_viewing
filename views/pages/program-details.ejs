<section class="program-page">
  <header class="program-hero">
    <div class="program-hero-text">
      <h1><%= program.name %></h1>
      <p class="muted"><%= program.summary || "Details coming soon." %></p>

      <div class="program-cta-row">
        <a class="btn btn-primary" href="/contact">Inquire</a>
        <a class="btn" href="/programs">← Back to Programs</a>
      </div>
    </div>

   <div class="program-hero-media">
  <img
    class="program-image"
    src="/assets/images/programs/<%= program.slug %>.jpg"
    alt="<%= program.name %>"
    onerror="this.style.display='none'; this.insertAdjacentHTML('afterend','<div class=&quot;img-placeholder&quot;><span>No image yet</span></div>')"
  />
</div>
  </header>

  <section class="program-section">
    <h2>About this program</h2>
  <p>
  <%= program.description || "Full description coming soon." %>
</p>
  </section>

 
</section>
