<section class="page-header">
  <h1>Admin — Barangay Reading Centers</h1>
  <p class="muted">Manage all BRC entries here. You can add new centers or edit existing ones.</p>
</section>

<div style="display:flex; gap:10px; margin-bottom:16px;">
  <a href="/admin/brc/new" class="btn btn-primary">Add New BRC</a>
  <a href="/admin/brc/update-affiliation" class="btn btn-outline" onclick="return confirm('This will update affiliation status for all existing BRCs. Continue?');">Update All Affiliations</a>
  <a href="/admin/brc/update-facebook-links" class="btn btn-outline" onclick="return confirm('This will update Facebook links for existing BRCs. Continue?');">Update Facebook Links</a>
</div>

<section class="card">
  <% if (!brcs || brcs.length===0) { %>
    <p class="muted">No reading centers created yet.</p>
    <% } else { %>
      <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse: collapse; text-align: left;">
          <thead>
            <tr style="border-bottom: 1px solid var(--border-color);">
              <th style="padding: 10px;">Cover</th>
              <th style="padding: 10px;">Name</th>
              <th style="padding: 10px;">Affiliation</th>
              <th style="padding: 10px;">Images</th>
              <th style="padding: 10px;">Actions</th>
            </tr>
          </thead>

          <tbody>
            <% brcs.forEach(b=> { %>
              <% const coverSrc=b.coverUrl || (b.coverImage ? ("/assets/brc/uploads/" + b.coverImage) : "" ); const
                picsCount=(b.imageUrls && b.imageUrls.length) ? b.imageUrls.length : (b.images ? b.images.length : 0);
                %>

                <tr style="border-bottom: 1px solid var(--border-color);">
                  <td style="padding: 10px;">
                    <% if (coverSrc) { %>
                      <img src="<%= coverSrc %>" alt="Cover"
                        style="width: 80px; height: 60px; object-fit: cover; border-radius: 4px;"
                        onerror="this.outerHTML='<span class=&quot;muted&quot;>No Cover</span>'">
                      <% } else { %>
                        <span class="muted">No Cover</span>
                        <% } %>
                  </td>

                  <td style="padding: 10px; font-weight: bold;">
                    <%= b.name %>
                  </td>

                  <td style="padding: 10px;">
                    <% if (b.affiliation === 'affiliated') { %>
                      <span style="display: inline-block; padding: 4px 8px; background-color: #28a745; color: white; font-size: 0.8rem; border-radius: 4px; font-weight: 500;">Affiliated</span>
                    <% } else { %>
                      <span style="display: inline-block; padding: 4px 8px; background-color: #6c757d; color: white; font-size: 0.8rem; border-radius: 4px; font-weight: 500;">Not Affiliated</span>
                    <% } %>
                  </td>

                  <td style="padding: 10px;">
                    <%= picsCount %> pics
                  </td>

                  <td style="padding: 10px; display:flex; gap:8px;">
                    <a href="/admin/brc/<%= b._id %>/edit" class="btn btn-outline btn-sm">Edit</a>

                    <form action="/admin/brc/<%= b._id %>/delete" method="POST"
                      onsubmit="return confirm('Are you sure you want to delete this center?');">
                      <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                  </td>
                </tr>
                <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
</section>